# Build and test image: Rust, an X server with a window manager and a compositor, and the packaging tools.
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb openbox xcompmgr xterm x11-utils imagemagick xdotool dbus-x11 \
    dpkg-dev rpm fakeroot file ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl
WORKDIR /src
